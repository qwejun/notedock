{
  "name": "@notedock/editor",
  "private": true,
  "version": "0.1.1",
  "type": "module",
  "svelte": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "svelte": "./src/index.ts",
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./styles/*": "./src/styles/*",
    "./generated/*": "./src/generated/*"
  },
  "scripts": {
    "check": "svelte-check --tsconfig ./tsconfig.json"
  },
  "dependencies": {
    "@tiptap/core": "3.31.0",
    "@tiptap/extension-collaboration": "3.31.0",
    "@tiptap/extension-highlight": "3.31.0",
    "@tiptap/extension-image": "3.31.0",
    "@tiptap/extension-placeholder": "3.31.0",
    "@tiptap/extension-text-style": "3.31.0",
    "@tiptap/starter-kit": "3.31.0",
    "y-indexeddb": "9.0.12",
    "y-prosemirror": "1.3.7",
    "yjs": "13.6.32"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "7.3.0",
    "svelte": "5.57.0",
    "svelte-check": "4.7.6",
    "typescript": "5.9.3",
    "vite": "8.2.2"
  }
}
